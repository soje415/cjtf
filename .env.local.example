NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# Prototype: ₦250 + ₦250 = ₦500 total, cleared in one transfer to the virtual account.
NEXT_PUBLIC_ID_CARD_FEE_KOBO=25000
NEXT_PUBLIC_TRAINING_FEE_KOBO=25000

RESEND_API_KEY=re_xxxxxxxxxxxx
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hyparrow KYC (NIN / BVN identity verification) + payments (virtual accounts)
HYPARROW_BASE_URL=https://api.hyparrow.cloud/api/v1
HYPARROW_API_KEY=pk_xxxxxxxxxxxx
HYPARROW_API_SECRET=sk_xxxxxxxxxxxx
# Webhook secret from the Hyparrow dashboard; used to verify customer.transaction.completed
HYPARROW_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
# Settlement bank for issued virtual accounts. Hyparrow takes a provider
# NAME here, not a numeric bank code. Supported: WEMA (default), 9PSB, FBP.
HYPARROW_VA_BANK_CODE=WEMA
